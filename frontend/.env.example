# Frontend API Configuration Template
#
# Local development:
# api.js automatically defaults to http://localhost:8080/api if unset.
# VITE_API_BASE_URL=http://localhost:8080/api
#
# Production:
# Once Google Cloud Run is deployed and its actual URL is confirmed:
# VITE_API_BASE_URL=https://ACTUAL-CLOUD-RUN-URL/api
VITE_API_BASE_URL=https://pm-internship-recommendation-q9bw.onrender.com/api